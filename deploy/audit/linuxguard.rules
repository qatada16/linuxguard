## LinuxGuard audit rules
## Install to /etc/audit/rules.d/50-linuxguard.rules and load with: augenrules --load

-b 8192
-f 1

## Process execution
-a always,exit -F arch=b64 -S execve,execveat -k lg_exec
-a always,exit -F arch=b32 -S execve,execveat -k lg_exec

## Credential stores
-w /etc/shadow -p rwa -k lg_credentials
-w /etc/gshadow -p rwa -k lg_credentials
-w /etc/security/opasswd -p rwa -k lg_credentials

## Account and privilege configuration
-w /etc/passwd -p wa -k lg_identity
-w /etc/group -p wa -k lg_identity
-w /etc/sudoers -p wa -k lg_identity
-w /etc/sudoers.d/ -p wa -k lg_identity

## Persistence locations
-w /etc/crontab -p wa -k lg_persistence
-w /etc/cron.d/ -p wa -k lg_persistence
-w /etc/cron.hourly/ -p wa -k lg_persistence
-w /etc/cron.daily/ -p wa -k lg_persistence
-w /etc/cron.weekly/ -p wa -k lg_persistence
-w /etc/cron.monthly/ -p wa -k lg_persistence
-w /var/spool/cron/ -p wa -k lg_persistence
-w /etc/systemd/system/ -p wa -k lg_persistence
-w /usr/lib/systemd/system/ -p wa -k lg_persistence
-w /root/.ssh/ -p wa -k lg_ssh_keys

## Security logs
-w /var/log/auth.log -p wa -k lg_logs
-w /var/log/syslog -p wa -k lg_logs
-w /var/log/wtmp -p wa -k lg_logs
-w /var/log/btmp -p wa -k lg_logs
-w /var/log/lastlog -p wa -k lg_logs
-w /var/log/audit/ -p wa -k lg_logs

## Audit configuration
-w /etc/audit/ -p wa -k lg_audit_config

## Kernel modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k lg_kernel_module

## Permission and ownership changes made by interactive users
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k lg_perm
-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k lg_perm

## Outbound IPv4 (a2=16) and IPv6 (a2=28) connections
-a always,exit -F arch=b64 -S connect -F a2=16 -k lg_network
-a always,exit -F arch=b64 -S connect -F a2=28 -k lg_network

## Renames and deletions inside home directories by interactive users
-a always,exit -F arch=b64 -S rename,renameat,renameat2,unlink,unlinkat -F dir=/home -F auid>=1000 -F auid!=unset -k lg_home_change
