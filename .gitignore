# Local Python environments and build output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Generated evidence, models and experiment output
/code/data/*
!/code/data/.gitkeep
/code/eval/results/
*.db
*.db-wal
*.db-shm

# Real audit logs and labels stay local; synthetic fixtures can be committed.
/code/tests/data/*
!/code/tests/data/README.md
*.log

# Credentials and editor files
.env
.env.*
!.env.example
*.pem
*.key
.idea/
.vscode/
*~
